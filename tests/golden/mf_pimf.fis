% mf_pimf.fis -- covers pimf membership. Mamdani centroid.
% Both MFs use valid pimf params (a<b<c<d): rising plateau, then fall.
[System]
Name='mf_pimf'
Type='mamdani'
Version=2.0
NumInputs=1
NumOutputs=1
NumRules=2
AndMethod='min'
OrMethod='max'
ImpMethod='min'
AggMethod='max'
DefuzzMethod='centroid'

[Input1]
Name='x'
Range=[0 10]
NumMFs=2
MF1='low':'pimf',[0 1 4 5]
MF2='high':'pimf',[5 6 9 10]

[Output1]
Name='y'
Range=[0 1]
NumMFs=2
MF1='lo':'trimf',[0 0 0.5]
MF2='hi':'trimf',[0.5 1 1]

[Rules]
1, 1 (1) : 1
2, 2 (1) : 1
