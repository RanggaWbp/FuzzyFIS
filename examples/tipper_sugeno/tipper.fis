% tipper_sugeno.fis -- the tipper problem as Sugeno, 2 inputs / 1 output / 3 rules
% Output MFs are constant/linear, so defuzzification is the weighted average.
[System]
Name='tipper_sugeno'
Type='sugeno'
Version=2.0
NumInputs=2
NumOutputs=1
NumRules=3
AndMethod='prod'
OrMethod='probor'
ImpMethod='prod'
AggMethod='sum'
DefuzzMethod='wtaver'

[Input1]
Name='service'
Range=[0 10]
NumMFs=3
MF1='poor':'gaussmf',[1.5 0]
MF2='good':'gaussmf',[1.5 5]
MF3='excellent':'gaussmf',[1.5 10]

[Input2]
Name='food'
Range=[0 10]
NumMFs=2
MF1='rancid':'gaussmf',[1.5 0]
MF2='delicious':'gaussmf',[1.5 10]

[Output1]
Name='tip'
Range=[0 30]
NumMFs=3
MF1='cheap':'constant',[5]
MF2='average':'linear',[0 1 10]
MF3='generous':'linear',[0.5 0.5 20]

[Rules]
1 1, 1 (1) : 1
2 2, 2 (1) : 1
3 2, 3 (1) : 1
