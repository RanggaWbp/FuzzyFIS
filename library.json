{
  "name": "FuzzyFIS",
  "version": "0.1.2",
  "description": "MATLAB-compatible fuzzy inference (Mamdani and Sugeno) for microcontrollers. Zero heap, no exceptions, float32.",
  "keywords": [
    "fuzzy",
    "fuzzy-logic",
    "mamdani",
    "sugeno",
    "fis",
    "matlab"
  ],
  "license": "MIT",
  "frameworks": "*",
  "platforms": "*",
  "headers": "fz.h",
  "build": {
    "srcDir": "src",
    "flags": [
      "-std=gnu++11"
    ]
  },
  "export": {
    "exclude": [
      "tests",
      "tools",
      "docs",
      ".github"
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/RanggaWbp/FuzzyFIS.git"
  },
  "homepage": "https://github.com/RanggaWbp/FuzzyFIS",
  "authors": [
    {
      "name": "RanggaWbp",
      "maintainer": true
    }
  ]
}
